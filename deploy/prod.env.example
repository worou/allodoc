# Configuration de production de l'API, copiée dans allodoc-api/.env.local par deploy/build.sh.
# Copier ce fichier en deploy/prod.env (non versionné) et renseigner les vraies valeurs.
APP_ENV=prod
APP_DEBUG=0
# Généré automatiquement par build.sh s'il est vide.
APP_SECRET=
DEFAULT_URI=https://allodoc.teranga.re

# Caractères spéciaux du mot de passe à encoder : @ -> %40, # -> %23, : -> %3A, / -> %2F
# serverVersion : version exacte affichée dans phpMyAdmin (ex. 10.6.21-MariaDB ou 8.0.36 pour MySQL)
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@localhost:3306/BASE?serverVersion=10.6.0-MariaDB&charset=utf8mb4"

API_PUBLIC_URL=https://allodoc.teranga.re
FRONTEND_URL=https://allodoc.teranga.re
# Origines autorisées : le site lui-même et l'application Android (https://localhost)
CORS_ALLOW_ORIGIN='^https?://(allodoc\.teranga\.re|localhost)(:[0-9]+)?$'

# Emails (codes de connexion) : fonction mail() de l'hébergement, ou SMTP d'une boîte email du domaine :
# MAILER_DSN=smtp://no-reply%40teranga.re:MOT_DE_PASSE@SERVEUR.o2switch.net:465
MAILER_DSN=native://default
MAILER_FROM="AlloDoc <no-reply@teranga.re>"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
